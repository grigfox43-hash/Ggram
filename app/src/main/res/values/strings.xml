    <string name="pref_media_turbo">Turbo Multi-Thread Downloader</string>
    <string name="pref_media_turbo_desc">Accelerates file downloads up to 4 GB with 4–8 concurrent threads</string>
    <string name="pref_media_bg_playback">Background Circle &amp; Audio Playback</string>
    <string name="pref_media_bg_playback_desc">Continue playing voice notes and video circles with screen locked</string>

