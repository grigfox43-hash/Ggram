    <string name="pref_ghost_stories_desc">Watch stories anonymously without appearing in view list</string>
    <string name="pref_confirm_voice">Confirm Voice Message Send</string>
    <string name="pref_confirm_voice_desc">Ask for confirmation before sending audio messages</string>
    <string name="pref_confirm_video">Confirm Video Message Send</string>
    <string name="pref_confirm_video_desc">Ask for confirmation before sending video circle notes</string>
    <string name="pref_confirm_stickers">Confirm Sticker Tap</string>
    <string name="pref_confirm_stickers_desc">Prevent accidental sticker sending on single tap</string>
    <string name="pref_confirm_calls">Confirm Phone Calls</string>
    <string name="pref_confirm_calls_desc">Prompt before initiating voice or video calls</string>

