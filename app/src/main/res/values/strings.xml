    <string name="pref_storage_clean_circles">Clean Video Circles Cache</string>
    <string name="pref_storage_clean_stickers">Clean Stickers Cache</string>

    <!-- Ergonomics -->
    <string name="pref_chat_copy_snippet">Copy Selected Snippet</string>
    <string name="pref_chat_copy_snippet_desc">Select and copy partial text instead of whole message</string>
    <string name="pref_chat_forward_clean">Forward Without Author</string>
    <string name="pref_chat_forward_clean_desc">1-tap forward stripping original sender quote</string>
    <string name="pref_chat_hide_blocked">Hide Blocked Users in Groups</string>
    <string name="pref_chat_hide_blocked_desc">Completely removes messages of blocked users from group feeds</string>

