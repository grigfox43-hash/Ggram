    <string name="pref_bypass_flag_secure">Allow Screenshots Anywhere</string>
    <string name="pref_bypass_flag_secure_desc">Disables FLAG_SECURE to permit screenshots and screen recording</string>
    <string name="pref_bypass_noforwards">Bypass Channel Protection</string>
    <string name="pref_bypass_noforwards_desc">Enables copying text, forwarding and saving in restricted channels</string>

