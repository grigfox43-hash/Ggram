    <string name="pref_notif_essential_only">Essential Pushes Only</string>
    <string name="pref_notif_essential_only_desc">Only alert for direct messages and @username mentions</string>
    <string name="pref_notif_quiet_hours">Night Quiet Hours</string>
    <string name="pref_notif_quiet_hours_desc">Automatically silence channel notifications from 23:00 to 08:00</string>

    <!-- AI & Free Premium -->
    <string name="pref_ai_v2t">Free Voice-to-Text</string>
    <string name="pref_ai_v2t_desc">Transcribe voice and video messages to text without Telegram Premium</string>
    <string name="pref_ai_translator">In-Line Message Translator</string>
    <string name="pref_ai_translator_desc">One-tap instant translation via Google, DeepL, or Yandex</string>
    <string name="pref_ai_summarizer">Channel AI Summarizer</string>
    <string name="pref_ai_summarizer_desc">Generate concise bullet points for long channel posts</string>

