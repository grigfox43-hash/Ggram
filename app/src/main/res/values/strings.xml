    <string name="pref_ui_show_id_dc_desc">Displays DC and numeric Telegram ID in profile pages</string>
    <string name="pref_ui_unlimited_pins">Unlimited Pinned Chats</string>
    <string name="pref_ui_unlimited_pins_desc">Pin as many chats as you want in folder tabs</string>

