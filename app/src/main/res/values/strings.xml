    <string name="pref_profiler_mutual">Mutual Contact Indicator</string>
    <string name="pref_profiler_mutual_desc">Shows if the user has your phone number saved in their contacts</string>

    <!-- Storage Cleaner -->
    <string name="pref_storage_channel_quota">Channel Storage Quota</string>
