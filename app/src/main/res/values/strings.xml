    <string name="pref_antirecall_save_deleted">Save Deleted Messages</string>
    <string name="pref_antirecall_save_deleted_desc">Retains deleted messages with red [Deleted] badge</string>
    <string name="pref_antirecall_edit_history">Message Edit History</string>
    <string name="pref_antirecall_edit_history_desc">Keeps previous revisions of edited messages with diff viewer</string>
    <string name="pref_antirecall_save_self_destruct">Save Self-Destructing Media</string>
    <string name="pref_antirecall_save_self_destruct_desc">Automatically saves disappearing photos and videos to vault</string>

