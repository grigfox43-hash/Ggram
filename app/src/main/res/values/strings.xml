    <string name="pref_sec_double_bottom">Double Bottom System</string>
    <string name="pref_sec_double_bottom_desc">Unlock decoy profile or hide sensitive chats using panic PIN</string>
    <string name="pref_sec_data_redaction">Sensitive Data Redaction</string>
    <string name="pref_sec_data_redaction_desc">Automatically mask phone numbers, cards, and crypto wallets on screenshots</string>

