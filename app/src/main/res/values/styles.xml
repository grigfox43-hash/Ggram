<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GgramTextHeader">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ggram_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="GgramTextTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ggram_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="GgramTextDesc">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ggram_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
