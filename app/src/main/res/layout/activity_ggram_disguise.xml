<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ggram_black"
    android:padding="20dp">

    <TextView
        android:id="@+id/calc_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:text="0"
        android:textColor="@color/ggram_text_primary"
        android:textSize="48sp"
        android:paddingBottom="24dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins">

        <Button android:id="@+id/btn_clear" android:text="C" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/ggram_green" />
        <Button android:text="+/-" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/ggram_green" />
        <Button android:text="%" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/ggram_green" />
        <Button android:text="÷" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/ggram_green" />

        <Button android:id="@+id/btn_7" android:text="7" textColor="#FFFFFF" />
        <Button android:id="@+id/btn_8" android:text="8" textColor="#FFFFFF" />
        <Button android:id="@+id/btn_9" android:text="9" textColor="#FFFFFF" />
        <Button android:text="×" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/ggram_green" />

        <Button android:id="@+id/btn_4" android:text="4" textColor="#FFFFFF" />
        <Button android:id="@+id/btn_5" android:text="5" textColor="#FFFFFF" />
        <Button android:id="@+id/btn_6" android:text="6" textColor="#FFFFFF" />
        <Button android:text="-" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/ggram_green" />

        <Button android:id="@+id/btn_1" android:text="1" textColor="#FFFFFF" />
        <Button android:id="@+id/btn_2" android:text="2" textColor="#FFFFFF" />
        <Button android:id="@+id/btn_3" android:text="3" textColor="#FFFFFF" />
        <Button android:text="+" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="@color/ggram_green" />

        <Button android:id="@+id/btn_0" android:text="0" android:layout_columnSpan="2" android:layout_gravity="fill_horizontal" textColor="#FFFFFF" />
        <Button android:text="." textColor="#FFFFFF" />
        <Button android:id="@+id/btn_equals" android:text="=" backgroundTint="@color/ggram_green" textColor="#FFFFFF" />

    </GridLayout>

</LinearLayout>
