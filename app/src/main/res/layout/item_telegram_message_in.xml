<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingStart="12dp"
    android:paddingEnd="48dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_edited"
        android:backgroundTint="@color/ggram_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/msg_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pavel Durov"
            android:textColor="@color/ggram_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/msg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Привет! Добро пожаловать в Ggram Telegram!"
            android:textColor="@color/ggram_text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/msg_deleted_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[Удалено]"
                android:textColor="#FF4D4D"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/msg_edited_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[Изм.]"
                android:textColor="@color/ggram_green"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/msg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:23"
                android:textColor="@color/ggram_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
