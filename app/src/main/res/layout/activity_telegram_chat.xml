<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ggram_black"
    android:orientation="vertical">

    <!-- CHAT TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ggram_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_chat_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/chat_avatar_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_badge_edited"
                    android:gravity="center"
                    android:text="TG"
                    android:textColor="@color/ggram_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_chat_title_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_chat_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Telegram News"
                    android:textColor="@color/ggram_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_chat_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="в сети • Нажмите для инспектора профиля"
                    android:textColor="@color/ggram_green"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Profiler Info Button -->
            <ImageView
                android:id="@+id/btn_user_profiler"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/ggram_green"
                android:contentDescription="User Profiler"
                android:layout_marginEnd="6dp" />

            <!-- Jump to beginning of chat -->
            <ImageView
                android:id="@+id/btn_jump_first"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_upload"
                app:tint="@color/ggram_text_primary"
                android:contentDescription="Jump to First Message"
                android:layout_marginEnd="6dp" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- MESSAGES RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- INPUT PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ggram_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/btn_attach"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/ggram_text_secondary"
            android:contentDescription="Attach" />

        <EditText
            android:id="@+id/et_message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Сообщение..."
            android:maxLines="4"
            android:textColor="@color/ggram_text_primary"
            android:textColorHint="@color/ggram_text_secondary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btn_voice_record"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="@color/ggram_green"
            android:contentDescription="Voice Message" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_send_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/ggram_green"
            android:src="@android:drawable/ic_menu_send"
            app:fabCustomSize="42dp"
            app:tint="#FFFFFF"
            android:contentDescription="Send" />

    </LinearLayout>

</LinearLayout>
